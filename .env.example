# Ambiente
PORT=3000
NODE_ENV=development
# Em produção o APP_ENV deve ser production (para habilitar o cookie Secure)
APP_ENV=local

# Banco de Dados
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db?schema=public

# Autenticação
# Gere um segredo seguro usando o comando: openssl rand -base64 48
JWT_SECRET=

# Usuário Administrador Inicial (Seed)
ADMIN_EMAIL=
# ADMIN_PASSWORD deve ter no mínimo 12 caracteres (senhas fracas/padrão não são permitidas)
ADMIN_PASSWORD=

# Uploads (opcional, padrão: ./uploads)
UPLOAD_DIR=./uploads
