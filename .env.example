# Ambiente
PORT=3000
NODE_ENV=development
# Em produção o APP_ENV deve ser production (para habilitar o cookie Secure)
APP_ENV=local

# Banco de Dados
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_db
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db?schema=public

# Autenticação
# Gere um segredo seguro usando o comando: openssl rand -base64 48
JWT_SECRET=

# Usuário Administrador Inicial (Seed)
ADMIN_EMAIL=
# ADMIN_PASSWORD deve ter no mínimo 12 caracteres (senhas fracas/padrão não são permitidas)
ADMIN_PASSWORD=

# Uploads (opcional, padrão: ./uploads)
UPLOAD_DIR=./uploads

# CORS (opcional). Normalmente fica vazio: em produção o cliente e a API são
# servidos na mesma origem pelo Express, então CORS não é necessário. Só
# preencha com uma lista separada por vírgula (ex.: https://app.exemplo.com)
# se a API for acessada de uma origem diferente.
CORS_ORIGINS=

# Backup (opcional)
# Destino de envio offsite usado por scripts/backup.sh|ps1 (ex.: rclone:meu-bucket:crm-backups
# ou usuario@servidor-remoto:/backups/crm).
# OFFSITE_DESTINATION=

# Chave pública gerada com `age-keygen -o backup-key.txt` (veja README seção 5). Se definida,
# o backup é criptografado com `age` antes de ir para o destino offsite. Sem ela, o backup
# fica em texto claro — só use assim em ambiente de teste.
# BACKUP_ENCRYPTION_RECIPIENT=

# Caminho da chave privada correspondente (backup-key.txt), usado só por scripts/restore.sh|ps1
# para descriptografar um backup .tar.gz.age. Guarde essa chave fora da VPS.
# BACKUP_AGE_IDENTITY=
