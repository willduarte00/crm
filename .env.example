# Ambiente
PORT=3000
NODE_ENV=development
# Em produção o APP_ENV deve ser production (para habilitar o cookie Secure)
APP_ENV=local

# Banco de Dados
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_db
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db?schema=public

# Autenticação
# Gere um segredo seguro usando o comando: openssl rand -base64 48
JWT_SECRET=

# Usuário Administrador Inicial (Seed)
ADMIN_EMAIL=
# ADMIN_PASSWORD deve ter no mínimo 12 caracteres (senhas fracas/padrão não são permitidas)
ADMIN_PASSWORD=

# Uploads (opcional, padrão: ./uploads)
UPLOAD_DIR=./uploads

# CORS (opcional). Normalmente fica vazio: em produção o cliente e a API são
# servidos na mesma origem pelo Express, então CORS não é necessário. Só
# preencha com uma lista separada por vírgula (ex.: https://app.exemplo.com)
# se a API for acessada de uma origem diferente.
CORS_ORIGINS=
