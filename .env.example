# Ambiente
PORT=3000
NODE_ENV=development
APP_ENV=local

# Banco de Dados
DATABASE_URL=postgresql://crm_user:crm_password@db:5432/crm_db?schema=public

# Autenticação
# ATENÇÃO: JWT_SECRET deve ter ao menos 32 caracteres e ser diferente do exemplo
JWT_SECRET=

# Usuário Administrador Inicial (Seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploads (opcional, padrão: ./uploads)
UPLOAD_DIR=./uploads
